{:paths ["src" "test"]
 :deps {metosin/malli {:mvn/version "0.16.4"}}
 :tasks
 {:requires ([babashka.cli :as cli]
             [botashka.agent :as agent]
             [botashka.chat :as chat]
             [botashka.tools :as tools]
             [botashka.trace :as trace]
             [clojure.test :refer [run-tests]])

  test
  {:doc "Runs the deterministic automated test suite"
   :task (do
           (require 'botashka.agent-test)
           (let [r (run-tests 'botashka.agent-test)]
             (when (or (pos? (:fail r)) (pos? (:error r)))
               (System/exit 1))))}

  chat
  {:doc "Starts an interactive multi-turn REPL chat session in a workspace: bb chat [-w <dir>] [<dir>]"
   :task (let [opts (cli/parse-opts *command-line-args* {:alias {:w :workspace}
                                                         :args->opts [:workspace]})]
           (chat/chat-loop opts))}

  run
  {:doc "Runs the agent with an optional prompt and workspace: bb run [-w <dir>] [-g] [-f|--fast-path] [--policy <name>] [<prompt>]"
   :override-builtin true
   :task (let [opts (cli/parse-opts *command-line-args* {:alias {:w :workspace
                                                                 :g :graph
                                                                 :t :trace
                                                                 :f :fast-path
                                                                 :c :clef
                                                                 :p :policy}
                                                         :args->opts [:prompt]
                                                         :coerce {:graph :boolean
                                                                  :trace :boolean
                                                                  :fast-path :boolean
                                                                  :clef :boolean
                                                                  :policy :string}})
               workspace (or (:workspace opts) ".")
               graph? (boolean (or (:graph opts) (:trace opts)))
               policy-name (or (:policy opts)
                               (when (or (:fast-path opts) (:clef opts)) "fast-path")
                               "default")
               prompt (or (:prompt opts)
                          "What is the title of the project? Read README.md using available tools.")
               registry (tools/code-tool-registry workspace)
               policy (case policy-name
                        ("fast-path" "clef" "dual-system")
                        (do
                          (require 'botashka.clef-policy)
                          (require 'botashka.run)
                          ((resolve 'botashka.run/first-applicable-action-policy)
                           ((resolve 'botashka.clef-policy/clef-action-policy) {:min-probability 0.70})
                           (resolve 'botashka.run/default-action-policy)))
                        nil)
               run-opts (cond-> {:prompt prompt :tools registry}
                          policy (assoc :action-policy policy))
               result (agent/run! run-opts)]
           (when graph?
             (trace/render-trace-graph result))
           (println "\n=== Terminal Status ===")
           (println (:status result))
           (println "\n=== Text Answer ===")
           (println (or (:text result) "<no text>"))
           (println (str "\nTotal Steps: " (count (:log result))))
           (when-not (= :completed (:status result))
             (System/exit 1)))}}}
